@tailwind base;@tailwind components;@tailwind utilities;@layer base{body{@apply bg-[#FDFBF7] text-[#2D3748] font-sans antialiased select-none;touch-action:manipulation}}::-webkit-scrollbar{width:8px;height:8px}::-webkit-scrollbar-track{background:#f1e6d0;border-radius:4px}::-webkit-scrollbar-thumb{background:#d4a373;border-radius:4px}::-webkit-scrollbar-thumb:hover{background:#bc8a5f}.wood-pattern{background-color:#e6b870;background-image:radial-gradient(ellipse at 50% 50%,rgba(255,230,180,.4),rgba(180,120,50,.25)),repeating-linear-gradient(45deg,transparent,transparent 15px,rgba(160,100,40,.05) 15px,rgba(160,100,40,.05) 30px)}.candy-pattern{background-color:#fce7f3;background-image:radial-gradient(#F472B6 .75px,transparent .75px),radial-gradient(#60a5fa .75px,#fce7f3 .75px);background-size:30px 30px;background-position:0 0,15px 15px}.neon-pattern{background-color:#0f172a;background-image:linear-gradient(to right,#1E293B 1px,transparent 1px),linear-gradient(to bottom,#1E293B 1px,transparent 1px);background-size:20px 20px}.btn-cartoon{@apply transition-all duration-150 active:translate-y-1 active:shadow-none font-bold rounded-2xl cursor-pointer;}.font-cartoon{font-family:ZCOOL KuaiLe,Fredoka,Chalkboard SE,Comic Sans MS,PingFang SC,sans-serif;letter-spacing:.03em}.no-scrollbar::-webkit-scrollbar{display:none}.no-scrollbar{-ms-overflow-style:none;scrollbar-width:none}page{background-color:#fdfbf7;color:#2d3748;font-family:ZCOOL KuaiLe,Fredoka,Quicksand,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;box-sizing:border-box}view,text,button,image,scroll-view{box-sizing:border-box}.font-cartoon{font-family:ZCOOL KuaiLe,Fredoka,Quicksand,-apple-system,sans-serif!important}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}