/* ==========================================================================
   一诺弈学 - 微信原生小程序 1:1 像素级复刻全量样式库 (Tailwind CSS 等效实现)
   ========================================================================== */

page {
  background-color: #FDFBF7;
  color: #2D3748;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "WenQuanYi Micro Hei", sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, button, scroll-view, image {
  box-sizing: border-box;
}

/* 页面通用布局 */
.page-container {
  padding: 16rpx 20rpx 140rpx 20rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 顶部导航栏 (Navbar 1:1) */
.top-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 12rpx 20rpx;
  border-radius: 28rpx;
  border: 4rpx solid #FFEDD5;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-avatar-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FBBF24 0%, #F97316 50%, #F43F5E 100%);
  padding: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 8rpx rgba(249, 115, 22, 0.2);
}

.nav-avatar-emoji { font-size: 40rpx; }

.nav-title-group { display: flex; flex-direction: column; }
.nav-title-row { display: flex; align-items: center; gap: 8rpx; }
.nav-brand-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #EA580C;
  letter-spacing: 1rpx;
}
.nav-brand-tag {
  background: #FFEDD5;
  color: #9A3412;
  font-size: 18rpx;
  font-weight: 900;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  border: 1rpx solid #FDBA74;
}
.nav-brand-sub { font-size: 18rpx; color: #94A3B8; font-weight: 700; }

.nav-right { display: flex; align-items: center; gap: 10rpx; }

.nav-user-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF7ED;
  border: 2rpx solid #FED7AA;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 900;
  color: #9A3412;
}
.nav-user-caret { font-size: 14rpx; color: #FB923C; }

.nav-tool-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-svg-icon { width: 28rpx; height: 28rpx; }

/* 底部 7 栏悬浮导航栏 (1:1 with Web Mobile Nav) */
.bottom-tabbar-7 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(16px);
  border-top: 2rpx solid #FED7AA;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8rpx 4rpx env(safe-area-inset-bottom) 4rpx;
  z-index: 999;
}

.tab-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 4rpx 0;
}

.tab-pill-bar {
  position: absolute;
  top: -8rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #F97316 0%, #FB923C 100%);
  border-radius: 6rpx;
}

.tab-icon-wrapper {
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-icon-wrapper.active {
  background: #FFEDD5;
}

.tab-svg-icon { width: 34rpx; height: 34rpx; }

.tab-label-text {
  font-size: 19rpx;
  font-weight: 700;
  color: #64748B;
  margin-top: 2rpx;
}
.tab-label-text.active {
  color: #EA580C;
  font-weight: 900;
}

/* 木质棋盘外框 */
.wood-board-container {
  background-color: #E6B870;
  background-image: 
    radial-gradient(ellipse at 50% 50%, rgba(255, 230, 180, 0.4) 0%, rgba(180, 120, 50, 0.25) 100%),
    repeating-linear-gradient(45deg, transparent, transparent 15px, rgba(160, 100, 40, 0.05) 15px, rgba(160, 100, 40, 0.05) 30px);
  border: 8rpx solid #B47B36;
  border-radius: 36rpx;
  padding: 18rpx;
  box-shadow: 0 20rpx 35rpx -10rpx rgba(99, 59, 13, 0.35);
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
}

.board-aspect-square {
  width: 100%;
  aspect-ratio: 1 / 1;
}
.board-full-svg {
  width: 100%;
  height: 100%;
}

