.nav-back-arrow {
  font-size: 34rpx;
  color: #EA580C;
  font-weight: 900;
  margin-right: 4rpx;
}

.puzzle-progress-tag {
  background: #FEF3C7;
  color: #B45309;
  font-size: 20rpx;
  font-weight: 900;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #FDE68A;
}

.puzzle-banner-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  border: 4rpx solid #E9D5FF;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.puzzle-header-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.puzzle-main-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #6B21A8;
}

.puzzle-category-badge {
  font-size: 18rpx;
  background: #F3E8FF;
  color: #7E22CE;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 800;
}

.puzzle-prompt-text {
  font-size: 22rpx;
  color: #475569;
  line-height: 1.4;
}

.solved-success-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 4rpx solid #34D399;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(52, 211, 153, 0.15);
}

.solved-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.solved-badge-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #059669;
}

.solved-reward-pill {
  font-size: 20rpx;
  font-weight: 900;
  color: #D97706;
  background: #FEF3C7;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.solved-explanation-body {
  font-size: 21rpx;
  color: #475569;
  line-height: 1.4;
  background: #F0FDF4;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
}

.btn-next-step {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: white;
  font-size: 28rpx;
  font-weight: 900;
  border-radius: 22rpx;
  width: 100%;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.3);
}

.bottom-tools-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.btn-tool-outline {
  flex: 1;
  background: white;
  border: 3rpx solid #E2E8F0;
  color: #475569;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 22rpx;
  padding: 12rpx 0;
}

