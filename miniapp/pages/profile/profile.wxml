<view class="page-wrap">
  <!-- Top Navbar -->
  <view class="top-navbar">
    <view class="nav-left" bindtap="goHome">
      <text class="nav-back-arrow">←</text>
      <view class="nav-avatar-box">
        <text class="nav-avatar-emoji">🐼</text>
      </view>
      <view class="nav-title-group">
        <view class="nav-title-row">
          <text class="nav-brand-title">成长荣誉中心</text>
          <text class="nav-brand-tag">Profile</text>
        </view>
        <text class="nav-brand-slogan">记录你的每一步成长与辉煌</text>
      </view>
    </view>

    <view class="nav-right">
      <view class="nav-profile-pill">
        <text class="nav-user-avatar">🐼</text>
        <text class="nav-user-name">{{nickname}}</text>
      </view>
    </view>
  </view>

  <!-- User Profile Hero Card -->
  <view class="profile-hero-card">
    <view class="profile-avatar-large">{{avatar}}</view>
    <view class="profile-name-text">{{nickname}}</view>
    <view class="profile-rank-badge">🏅 {{rankTitle}}</view>

    <view class="profile-stats-grid">
      <view class="profile-stat-box">
        <text class="stat-num-val text-amber">{{stars}}</text>
        <text class="stat-lbl-sub">⭐ 收集星星</text>
      </view>
      <view class="profile-stat-box">
        <text class="stat-num-val text-orange">{{coins}}</text>
        <text class="stat-lbl-sub">🪙 金币余额</text>
      </view>
      <view class="profile-stat-box">
        <text class="stat-num-val text-purple">{{solvedCount}}</text>
        <text class="stat-lbl-sub">🧩 已解死活</text>
      </view>
    </view>
  </view>

  <!-- Certificate Box -->
  <view class="certificate-award-card">
    <view class="cert-seal-badge">
      <text class="cert-trophy">📜</text>
      <text class="cert-tag">官方认证荣誉大奖状</text>
    </view>
    <view class="cert-title">一诺弈学 · 少儿棋力认证</view>
    <view class="cert-body">
      兹证明小棋手【{{nickname}}】在【一诺弈学少儿启蒙学院】完成系统修习与死活对战考验，棋理通达，手筋敏锐，特授予【{{rankTitle}}】段位称号！
    </view>
  </view>

  <!-- 7-Tab Bottom Floating Navigation Bar -->
  <view class="bottom-tabbar-7">
    <view class="tab-btn" bindtap="navTo" data-url="/pages/index/index">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </view>
      <text class="tab-label-text">首页</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/learn/learn">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="12" x2="10" y2="12"></line>
          <line x1="8" y1="10" x2="8" y2="14"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <line x1="18" y1="11" x2="18.01" y2="11"></line>
          <rect width="20" height="12" x="2" y="6" rx="6"></rect>
        </svg>
      </view>
      <text class="tab-label-text">闯关</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </view>
      <text class="tab-label-text">乐园</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline>
          <line x1="13" y1="19" x2="19" y2="13"></line>
          <line x1="16" y1="16" x2="20" y2="20"></line>
          <line x1="19" y1="21" x2="21" y2="19"></line>
          <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline>
          <line x1="5" y1="14" x2="9" y2="18"></line>
          <line x1="7" y1="17" x2="4" y2="20"></line>
          <line x1="3" y1="19" x2="5" y2="21"></line>
        </svg>
      </view>
      <text class="tab-label-text">吃子</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/tsumego/tsumego">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.704 1.076.704 1.704s-.234 1.234-.704 1.704l-1.568 1.568a1.183 1.183 0 0 0-.289.878c.045.324-.06.653-.29.883l-1.568 1.568a2.41 2.41 0 0 1-1.704.704c-.628 0-1.234-.234-1.704-.704l-1.568-1.568a1.183 1.183 0 0 0-.878-.289c-.324.045-.653-.06-.883-.29l-1.568-1.568a2.41 2.41 0 0 1-.704-1.704c0-.628.234-1.234.704-1.704l1.568-1.568a1.183 1.183 0 0 0 .289-.878c-.045-.324.06-.653.29-.883l1.568-1.568a2.41 2.41 0 0 1 1.704-.704c.628 0 1.234.234 1.704.704l1.568 1.568c.23.23.335.559.29.883z"></path>
        </svg>
      </view>
      <text class="tab-label-text">死活</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </view>
      <text class="tab-label-text">商城</text>
    </view>

    <view class="tab-btn active" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="tab-pill-bar"></view>
      <view class="tab-icon-wrapper active">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <polyline points="16 11 18 13 22 9"></polyline>
        </svg>
      </view>
      <text class="tab-label-text active">我的</text>
    </view>
  </view>
</view>

