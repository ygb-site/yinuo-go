.nav-back-arrow { font-size: 34rpx; color: #EA580C; font-weight: 900; margin-right: 4rpx; }

.profile-hero-card {
  background: white;
  border-radius: 36rpx;
  padding: 36rpx 24rpx;
  border: 4rpx solid #BAE6FD;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(186, 230, 253, 0.3);
}

.profile-avatar-large { font-size: 88rpx; margin-bottom: 8rpx; }
.profile-name-text { font-size: 36rpx; font-weight: 900; color: #0369A1; margin-bottom: 6rpx; }
.profile-rank-badge {
  font-size: 24rpx;
  font-weight: 900;
  background: #E0F2FE;
  color: #0284C7;
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.profile-stats-grid {
  display: flex;
  width: 100%;
  border-top: 2rpx solid #F0F9FF;
  padding-top: 20rpx;
}

.profile-stat-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num-val { font-size: 34rpx; font-weight: 900; }
.text-amber { color: #D97706; }
.text-orange { color: #EA580C; }
.text-purple { color: #7C3AED; }
.stat-lbl-sub { font-size: 20rpx; color: #64748B; font-weight: 700; margin-top: 4rpx; }

.certificate-award-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  border: 4rpx solid #FDE68A;
  box-shadow: 0 8rpx 16rpx rgba(253, 230, 138, 0.3);
}

.cert-seal-badge { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.cert-trophy { font-size: 32rpx; }
.cert-tag { font-size: 20rpx; font-weight: 900; color: #B45309; background: rgba(255,255,255,0.7); padding: 4rpx 14rpx; border-radius: 12rpx; }
.cert-title { font-size: 30rpx; font-weight: 900; color: #92400E; margin-bottom: 6rpx; }
.cert-body { font-size: 22rpx; color: #78350F; line-height: 1.45; font-weight: 600; }

