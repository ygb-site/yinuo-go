<view class="page-wrap">
  <!-- Top Navigation Header (1:1 with Web Navbar) -->
  <view class="top-nav-bar">
    <view class="nav-brand-left" bindtap="goHome">
      <view class="nav-logo-box">
        <text class="nav-logo-emoji">🐼</text>
      </view>
      <view class="nav-brand-text">
        <view class="nav-brand-title-row">
          <text class="nav-brand-title">一诺弈学</text>
          <text class="nav-brand-badge">YiNuo Go</text>
        </view>
        <text class="nav-brand-slogan">少儿互动启蒙 · 快乐学棋</text>
      </view>
    </view>

    <view class="nav-right-actions">
      <view class="nav-profile-pill">
        <text class="nav-user-avatar">🐼</text>
        <text class="nav-user-name">{{nickname}}</text>
        <text class="nav-user-caret">▼</text>
      </view>
      <view class="nav-icon-btn">
        <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
      </view>
      <view class="nav-icon-btn">
        <svg class="nav-svg-icon text-amber" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </view>
    </view>
  </view>

  <!-- Header Hero Card (1:1 with Image #1) -->
  <view class="learn-hero-card">
    <view class="hero-map-tag">
      <text class="hero-map-icon">🧸</text>
      <text>少儿启蒙闯关大冒险 (Adventure Map)</text>
    </view>
    <view class="learn-hero-title">围棋小精灵成长之路</view>
    <view class="learn-hero-sub">跟着萌宠小诺一起闯关，从认识星位到掌握绝妙吃子手筋，收集满天繁星！</view>

    <view class="hero-stats-row">
      <view class="stat-pill-box">
        <text class="stat-pill-lbl">收集星星</text>
        <view class="stat-pill-val text-amber">
          <text class="stat-star-icon">⭐</text>
          <text>{{totalStars}}</text>
        </view>
      </view>

      <view class="stat-pill-box">
        <text class="stat-pill-lbl">金币奖励</text>
        <view class="stat-pill-val text-amber">
          <text class="stat-coin-icon">🪙</text>
          <text>{{coins}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Horizontal Scrollable Chapter Tabs (1:1 with Image #1) -->
  <scroll-view class="chapter-tabs-scroll" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{chapters}}"
      wx:key="id"
      class="chap-tab-pill {{activeChapterId === item.id ? 'active' : ''}}"
      bindtap="selectChapter"
      data-id="{{item.id}}"
    >
      <text class="chap-tab-icon">{{item.icon}}</text>
      <text class="chap-tab-text">第{{item.id}}章 ({{item.lessons.length}}关)</text>
    </view>
  </scroll-view>

  <!-- Active Chapter Header Banner (1:1 with Image #1) -->
  <view class="chapter-banner grad-chapter-{{activeChapter.id}}">
    <text class="chap-banner-en">{{activeChapter.titleEn}}</text>
    <view class="chap-banner-title">{{activeChapter.title}}</view>
    <text class="chap-banner-desc">{{activeChapter.description}}</text>
  </view>

  <!-- Lesson Cards List (1:1 with Image #1) -->
  <view class="lessons-list">
    <view
      wx:for="{{activeChapter.lessons}}"
      wx:key="id"
      class="lesson-card {{item.isUnlocked ? '' : 'locked'}}"
      bindtap="startLesson"
      data-id="{{item.id}}"
      data-unlocked="{{item.isUnlocked}}"
    >
      <view class="lesson-card-top">
        <view class="lesson-top-left">
          <view class="lesson-num-badge">{{activeChapter.id}}-{{index + 1}}</view>
          <view class="lesson-type-tag {{item.type === 'story' ? 'tag-blue' : 'tag-amber'}}">
            <text>{{item.type === 'story' ? '📖 趣味故事' : '🎯 围棋死活'}}</text>
          </view>
        </view>

        <view class="lesson-stars-row">
          <text class="star-icon {{item.stars >= 1 ? 'earned' : 'empty'}}">⭐</text>
          <text class="star-icon {{item.stars >= 2 ? 'earned' : 'empty'}}">⭐</text>
          <text class="star-icon {{item.stars >= 3 ? 'earned' : 'empty'}}">⭐</text>
        </view>
      </view>

      <view class="lesson-card-mid">
        <view class="lesson-main-title">
          <text>{{item.title}}</text>
          <text wx:if="{{!item.isUnlocked}}" class="lock-icon">🔒</text>
        </view>
        <text class="lesson-desc">{{item.description}}</text>
      </view>

      <view class="lesson-card-bottom">
        <text class="lesson-goal-text">目标：{{item.goalText}}</text>
        <view class="btn-lesson-play {{item.isUnlocked ? 'btn-play-active' : 'btn-play-locked'}}">
          <text class="btn-play-icon">▶</text>
          <text>{{item.stars > 0 ? '再次挑战' : '开始闯关'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 7-Tab Bottom Floating Navigation Bar (1:1 with Web) -->
  <view class="custom-bottom-tabbar">
    <view class="tab-item" bindtap="navTo" data-url="/pages/index/index">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </view>
      <text class="tab-label">首页</text>
    </view>

    <view class="tab-item active" bindtap="navTo" data-url="/pages/learn/learn">
      <view class="tab-indicator"></view>
      <view class="tab-icon-box active">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="12" x2="10" y2="12"></line>
          <line x1="8" y1="10" x2="8" y2="14"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <line x1="18" y1="11" x2="18.01" y2="11"></line>
          <rect width="20" height="12" x="2" y="6" rx="6"></rect>
        </svg>
      </view>
      <text class="tab-label active">闯关</text>
    </view>

    <view class="tab-item" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </view>
      <text class="tab-label">乐园</text>
    </view>

    <view class="tab-item" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline>
          <line x1="13" y1="19" x2="19" y2="13"></line>
          <line x1="16" y1="16" x2="20" y2="20"></line>
          <line x1="19" y1="21" x2="21" y2="19"></line>
          <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline>
          <line x1="5" y1="14" x2="9" y2="18"></line>
          <line x1="7" y1="17" x2="4" y2="20"></line>
          <line x1="3" y1="19" x2="5" y2="21"></line>
        </svg>
      </view>
      <text class="tab-label">吃子</text>
    </view>

    <view class="tab-item" bindtap="navTo" data-url="/pages/tsumego/tsumego">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.704 1.076.704 1.704s-.234 1.234-.704 1.704l-1.568 1.568a1.183 1.183 0 0 0-.289.878c.045.324-.06.653-.29.883l-1.568 1.568a2.41 2.41 0 0 1-1.704.704c-.628 0-1.234-.234-1.704-.704l-1.568-1.568a1.183 1.183 0 0 0-.878-.289c-.324.045-.653-.06-.883-.29l-1.568-1.568a2.41 2.41 0 0 1-.704-1.704c0-.628.234-1.234.704-1.704l1.568-1.568a1.183 1.183 0 0 0 .289-.878c-.045-.324.06-.653.29-.883l1.568-1.568a2.41 2.41 0 0 1 1.704-.704c.628 0 1.234.234 1.704.704l1.568 1.568c.23.23.559.335.883.29l1.568-1.568a2.41 2.41 0 0 1 1.704-.704c.628 0 1.234.234 1.704.704l1.568 1.568c.23.23.335.559.29.883z"></path>
        </svg>
      </view>
      <text class="tab-label">死活</text>
    </view>

    <view class="tab-item" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </view>
      <text class="tab-label">商城</text>
    </view>

    <view class="tab-item" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <polyline points="16 11 18 13 22 9"></polyline>
        </svg>
      </view>
      <text class="tab-label">我的</text>
    </view>
  </view>
</view>

