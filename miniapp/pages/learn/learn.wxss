.page-wrap {
  padding: 16rpx 20rpx 140rpx 20rpx;
  background-color: #FDFBF7;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Top Nav 1:1 */
.top-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  padding: 14rpx 20rpx;
  border-radius: 28rpx;
  border: 4rpx solid #FFEDD5;
}
.nav-brand-left { display: flex; align-items: center; gap: 12rpx; }
.nav-logo-box {
  width: 68rpx; height: 68rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, #F97316 0%, #FB923C 100%);
  display: flex; align-items: center; justify-content: center;
}
.nav-logo-emoji { font-size: 38rpx; }
.nav-brand-text { display: flex; flex-direction: column; }
.nav-brand-title-row { display: flex; align-items: center; gap: 8rpx; }
.nav-brand-title { font-size: 30rpx; font-weight: 900; color: #EA580C; }
.nav-brand-badge { background: #FFEDD5; color: #9A3412; font-size: 16rpx; font-weight: 800; padding: 2rpx 8rpx; border-radius: 10rpx; }
.nav-brand-slogan { font-size: 16rpx; color: #94A3B8; font-weight: 700; }

.nav-right-actions { display: flex; align-items: center; gap: 10rpx; }
.nav-profile-pill {
  display: flex; align-items: center; gap: 6rpx;
  background: #FFF7ED; border: 2rpx solid #FED7AA;
  padding: 6rpx 14rpx; border-radius: 20rpx;
  font-size: 20rpx; font-weight: 800; color: #9A3412;
}
.nav-user-avatar { font-size: 24rpx; }
.nav-user-caret { font-size: 14rpx; color: #FB923C; }
.nav-icon-btn {
  width: 52rpx; height: 52rpx; border-radius: 16rpx;
  background: #F8FAFC; border: 2rpx solid #E2E8F0;
  display: flex; align-items: center; justify-content: center;
}
.nav-svg-icon { width: 28rpx; height: 28rpx; }

/* Learn Hero Card 1:1 */
.learn-hero-card {
  background: white;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  border: 4rpx solid #FFEDD5;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-map-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #FFEDD5;
  color: #9A3412;
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 10rpx;
}
.hero-map-icon { font-size: 20rpx; }

.learn-hero-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #1E293B;
  margin-bottom: 6rpx;
}

.learn-hero-sub {
  font-size: 20rpx;
  color: #64748B;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.hero-stats-row {
  display: flex;
  gap: 24rpx;
}

.stat-pill-box {
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  text-align: center;
}
.stat-pill-lbl { font-size: 18rpx; color: #B45309; font-weight: 800; display: block; }
.stat-pill-val { font-size: 32rpx; font-weight: 900; color: #78350F; display: flex; align-items: center; justify-content: center; gap: 6rpx; }
.stat-star-icon, .stat-coin-icon { font-size: 24rpx; }

/* Chapter Tabs Scroll 1:1 */
.chapter-tabs-scroll {
  white-space: nowrap;
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.chap-tab-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: white;
  border: 2rpx solid #FED7AA;
  padding: 12rpx 22rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 900;
  color: #475569;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.02);
}

.chap-tab-pill.active {
  background: linear-gradient(135deg, #F97316 0%, #FB923C 100%);
  color: white;
  border-color: transparent;
  box-shadow: 0 6rpx 14rpx rgba(249, 115, 22, 0.3);
}
.chap-tab-icon { font-size: 26rpx; }

/* Chapter Banner 1:1 */
.chapter-banner {
  border-radius: 28rpx;
  padding: 24rpx;
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.08);
}
.grad-chapter-1 { background: linear-gradient(135deg, #059669 0%, #0D9488 50%, #0891B2 100%); }
.grad-chapter-2 { background: linear-gradient(135deg, #EA580C 0%, #F59E0B 100%); }
.grad-chapter-3 { background: linear-gradient(135deg, #7C3AED 0%, #DB2777 100%); }
.grad-chapter-4 { background: linear-gradient(135deg, #E11D48 0%, #F97316 100%); }
.grad-chapter-5 { background: linear-gradient(135deg, #2563EB 0%, #06B6D4 100%); }
.grad-chapter-6 { background: linear-gradient(135deg, #D97706 0%, #E11D48 100%); }

.chap-banner-en { font-size: 16rpx; font-weight: 800; opacity: 0.85; letter-spacing: 1rpx; display: block; }
.chap-banner-title { font-size: 32rpx; font-weight: 900; margin: 4rpx 0; }
.chap-banner-desc { font-size: 20rpx; opacity: 0.95; line-height: 1.35; display: block; }

/* Lesson Cards 1:1 */
.lessons-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lesson-card {
  background: white;
  border-radius: 28rpx;
  padding: 22rpx 20rpx;
  border: 4rpx solid #F1F5F9;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.lesson-card.locked { opacity: 0.6; }

.lesson-card-top { display: flex; justify-content: space-between; align-items: center; }
.lesson-top-left { display: flex; align-items: center; gap: 10rpx; }

.lesson-num-badge {
  background: #FFEDD5;
  color: #EA580C;
  font-size: 20rpx;
  font-weight: 900;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.lesson-type-tag {
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}
.tag-blue { background: #EEF2FF; color: #4F46E5; }
.tag-amber { background: #FFFBEB; color: #D97706; }

.lesson-stars-row { display: flex; gap: 4rpx; font-size: 24rpx; }
.star-icon.earned { color: #F59E0B; }
.star-icon.empty { color: #E2E8F0; }

.lesson-card-mid { display: flex; flex-direction: column; gap: 4rpx; }
.lesson-main-title { font-size: 28rpx; font-weight: 900; color: #1E293B; }
.lock-icon { font-size: 22rpx; margin-left: 8rpx; }
.lesson-desc { font-size: 20rpx; color: #64748B; line-height: 1.35; }

.lesson-card-bottom {
  border-top: 2rpx solid #F8FAFC;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lesson-goal-text { font-size: 20rpx; font-weight: 800; color: #EA580C; flex: 1; margin-right: 12rpx; }

.btn-lesson-play {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}
.btn-play-active {
  background: linear-gradient(135deg, #F97316 0%, #FB923C 100%);
  color: white;
  box-shadow: 0 4rpx 10rpx rgba(249, 115, 22, 0.25);
}
.btn-play-locked { background: #E2E8F0; color: #94A3B8; }
.btn-play-icon { font-size: 16rpx; }

/* 7-Tab Custom Bottom Navigation Bar */
.custom-bottom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  border-top: 2rpx solid #FED7AA;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8rpx 6rpx env(safe-area-inset-bottom) 6rpx;
  z-index: 100;
}

.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; padding: 4rpx 0; }
.tab-indicator { position: absolute; top: -8rpx; width: 44rpx; height: 6rpx; background: linear-gradient(135deg, #F97316 0%, #FB923C 100%); border-radius: 6rpx; display: none; }
.tab-item.active .tab-indicator { display: block; }
.tab-icon-box { padding: 6rpx 14rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; }
.tab-icon-box.active { background: #FFEDD5; }
.tab-svg { width: 34rpx; height: 34rpx; }
.tab-label { font-size: 18rpx; font-weight: 700; color: #64748B; margin-top: 2rpx; }
.tab-label.active { color: #EA580C; font-weight: 900; }

