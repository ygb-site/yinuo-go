<view class="page-container">
  <!-- Top Navbar -->
  <view class="top-navbar">
    <view class="nav-left" bindtap="goBack">
      <text class="nav-back-arrow">←</text>
      <view class="nav-avatar-box">
        <text class="nav-avatar-emoji">🐼</text>
      </view>
      <view class="nav-title-group">
        <view class="nav-title-row">
          <text class="nav-brand-title">{{lesson.title}}</text>
        </view>
        <text class="nav-brand-sub">{{lesson.category}}</text>
      </view>
    </view>

    <view class="puzzle-progress-tag">
      {{lesson.type === 'story' ? '📖 故事关' : '🎯 死活关'}}
    </view>
  </view>

  <!-- Prompt Box -->
  <view class="puzzle-banner-card">
    <text class="puzzle-prompt-text">{{lesson.prompt}}</text>
  </view>

  <!-- Wood GoBoard SVG -->
  <view class="wood-board-container">
    <view class="board-aspect-square">
      <svg class="board-full-svg" viewBox="0 0 {{size * 100}} {{size * 100}}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="lessonBlackGrad" cx="35%" cy="32%" r="68%">
            <stop offset="0%" stop-color="#4A5568" />
            <stop offset="35%" stop-color="#1A202C" />
            <stop offset="100%" stop-color="#090D14" />
          </radialGradient>
          <radialGradient id="lessonWhiteGrad" cx="32%" cy="30%" r="70%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="65%" stop-color="#F1F5F9" />
            <stop offset="100%" stop-color="#CBD5E1" />
          </radialGradient>
        </defs>

        <rect width="{{size * 100}}" height="{{size * 100}}" fill="#FBBF24" rx="24" />

        <!-- Grid Lines -->
        <g stroke="#78350F" stroke-width="3" stroke-linecap="round">
          <line wx:for="{{gridLines}}" wx:key="*this" x1="50" y1="{{item * 100 + 50}}" x2="{{(size - 1) * 100 + 50}}" y2="{{item * 100 + 50}}" />
          <line wx:for="{{gridLines}}" wx:key="*this" x1="{{item * 100 + 50}}" y1="50" x2="{{item * 100 + 50}}" y2="{{(size - 1) * 100 + 50}}" />
        </g>

        <!-- Center Star -->
        <circle cx="{{centerCoord}}" cy="{{centerCoord}}" r="8" fill="#78350F" />

        <!-- 3D Stones -->
        <g wx:for="{{stonesList}}" wx:key="key">
          <circle cx="{{item.cx + 3}}" cy="{{item.cy + 4}}" r="42" fill="rgba(0,0,0,0.22)" />
          <circle cx="{{item.cx}}" cy="{{item.cy}}" r="42" fill="{{item.color === 'B' ? 'url(#lessonBlackGrad)' : 'url(#lessonWhiteGrad)'}}" stroke="{{item.color === 'B' ? '#0F172A' : '#94A3B8'}}" stroke-width="2" />
        </g>

        <!-- Last Move Red Dot -->
        <circle wx:if="{{lastMove}}" cx="{{lastMove.cx}}" cy="{{lastMove.cy}}" r="9" fill="#EF4444" stroke="#FFFFFF" stroke-width="2" />

        <!-- Touch Targets -->
        <rect wx:for="{{touchGrid}}" wx:key="key" x="{{item.x}}" y="{{item.y}}" width="100" height="100" fill="transparent" bindtap="handleCellTap" data-r="{{item.r}}" data-c="{{item.c}}" />
      </svg>
    </view>
  </view>

  <!-- Success Modal Overlay (1 Screen Perfect Fit) -->
  <view wx:if="{{isCompleted}}" class="modal-mask">
    <view class="modal-card">
      <view class="tag-pill">🎉 顺利通关 🏆</view>
      <view class="modal-title">闯关成功！太棒啦！</view>
      <view class="modal-sub">{{lesson.title}}</view>

      <view class="stars-row">
        <text class="star-item">⭐</text>
        <text class="star-item">⭐</text>
        <text class="star-item">⭐</text>
      </view>

      <view class="quote-box">
        <text class="panda-emoji">🐼</text>
        <text class="quote-text">小诺说：“太聪明啦！你落子的速度像闪电一样快！”</text>
      </view>

      <view class="rewards-grid">
        <view class="reward-pill bg-gold">🪙 金币 +25</view>
        <view class="reward-pill bg-blue">⚡ 经验 +60 XP</view>
      </view>

      <view class="explain-box">
        <view class="explain-title">📖 名师点睛与双语术语</view>
        <view class="explain-body">{{lesson.explanation}}</view>
      </view>

      <button class="btn-next-large" bindtap="goNext">进入下一关 ➡️</button>
      <view class="btn-secondary-row">
        <button class="btn-secondary" bindtap="goBack">返回地图</button>
        <button class="btn-secondary" bindtap="replay">再练一次</button>
      </view>
    </view>
  </view>
</view>

