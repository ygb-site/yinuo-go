<view class="page-wrap">
  <!-- Top Navbar -->
  <view class="top-navbar">
    <view class="nav-left" bindtap="goHome">
      <text class="nav-back-arrow">←</text>
      <view class="nav-avatar-box">
        <text class="nav-avatar-emoji">🐼</text>
      </view>
      <view class="nav-title-group">
        <view class="nav-title-row">
          <text class="nav-brand-title">萌宠对弈场</text>
          <text class="nav-brand-tag">AI Arena</text>
        </view>
        <text class="nav-brand-sub">7路趣味小棋盘 · 萌宠智能对战</text>
      </view>
    </view>

    <view class="arcade-ai-pill">
      🤖 难度: {{aiLevelName}}
    </view>
  </view>

  <!-- Game Status Info -->
  <view class="arcade-status-card">
    <view class="arcade-status-header">
      <view class="status-left">
        <text class="status-dot-black"></text>
        <text class="status-turn-text">{{isPlayerTurn ? '执黑先行 · 请落子' : '小萌宠思考中...'}}</text>
      </view>
      <text class="status-captures-text">提子: 黑 {{blackCaptures}} / 白 {{whiteCaptures}}</text>
    </view>
    <text class="arcade-status-sub">点击棋盘交叉点即可落子，萌宠会自动响应哦！</text>
  </view>

  <!-- 3D Wood GoBoard SVG -->
  <view class="wood-board-container">
    <view class="board-aspect-square">
      <svg class="board-full-svg" viewBox="0 0 {{size * 100}} {{size * 100}}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="arcadeBlackGrad" cx="35%" cy="32%" r="68%">
            <stop offset="0%" stop-color="#4A5568" />
            <stop offset="35%" stop-color="#1A202C" />
            <stop offset="100%" stop-color="#090D14" />
          </radialGradient>
          <radialGradient id="arcadeWhiteGrad" cx="32%" cy="30%" r="70%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="65%" stop-color="#F1F5F9" />
            <stop offset="100%" stop-color="#CBD5E1" />
          </radialGradient>
        </defs>

        <rect width="{{size * 100}}" height="{{size * 100}}" fill="#FBBF24" rx="24" />

        <!-- Grid Lines -->
        <g stroke="#78350F" stroke-width="3" stroke-linecap="round">
          <line wx:for="{{gridLines}}" wx:key="*this" x1="50" y1="{{item * 100 + 50}}" x2="{{(size - 1) * 100 + 50}}" y2="{{item * 100 + 50}}" />
          <line wx:for="{{gridLines}}" wx:key="*this" x1="{{item * 100 + 50}}" y1="50" x2="{{item * 100 + 50}}" y2="{{(size - 1) * 100 + 50}}" />
        </g>

        <!-- Center Star -->
        <circle cx="{{centerCoord}}" cy="{{centerCoord}}" r="8" fill="#78350F" />

        <!-- 3D Stones -->
        <g wx:for="{{stonesList}}" wx:key="key">
          <circle cx="{{item.cx + 3}}" cy="{{item.cy + 4}}" r="42" fill="rgba(0,0,0,0.22)" />
          <circle cx="{{item.cx}}" cy="{{item.cy}}" r="42" fill="{{item.color === 'B' ? 'url(#arcadeBlackGrad)' : 'url(#arcadeWhiteGrad)'}}" stroke="{{item.color === 'B' ? '#0F172A' : '#94A3B8'}}" stroke-width="2" />
        </g>

        <!-- Last Move Red Dot -->
        <circle wx:if="{{lastMove}}" cx="{{lastMove.cx}}" cy="{{lastMove.cy}}" r="9" fill="#EF4444" stroke="#FFFFFF" stroke-width="2" />

        <!-- Touch Targets -->
        <rect wx:for="{{touchGrid}}" wx:key="key" x="{{item.x}}" y="{{item.y}}" width="100" height="100" fill="transparent" bindtap="handleCellTap" data-r="{{item.r}}" data-c="{{item.c}}" />
      </svg>
    </view>
  </view>

  <!-- Bottom Actions -->
  <view class="bottom-tools-row">
    <button class="btn-arcade-reset" bindtap="resetGame">🔄 重新开局</button>
    <button class="btn-arcade-pass" bindtap="passMove">🏳️ 停一手 (Pass)</button>
  </view>

  <!-- 7-Tab Bottom Floating Navigation Bar -->
  <view class="bottom-tabbar-7">
    <view class="tab-btn" bindtap="navTo" data-url="/pages/index/index">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </view>
      <text class="tab-label-text">首页</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/learn/learn">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="12" x2="10" y2="12"></line>
          <line x1="8" y1="10" x2="8" y2="14"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <line x1="18" y1="11" x2="18.01" y2="11"></line>
          <rect width="20" height="12" x="2" y="6" rx="6"></rect>
        </svg>
      </view>
      <text class="tab-label-text">闯关</text>
    </view>

    <view class="tab-btn active" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="tab-pill-bar"></view>
      <view class="tab-icon-wrapper active">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </view>
      <text class="tab-label-text active">乐园</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline>
          <line x1="13" y1="19" x2="19" y2="13"></line>
          <line x1="16" y1="16" x2="20" y2="20"></line>
          <line x1="19" y1="21" x2="21" y2="19"></line>
          <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline>
          <line x1="5" y1="14" x2="9" y2="18"></line>
          <line x1="7" y1="17" x2="4" y2="20"></line>
          <line x1="3" y1="19" x2="5" y2="21"></line>
        </svg>
      </view>
      <text class="tab-label-text">吃子</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/tsumego/tsumego">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.704 1.076.704 1.704s-.234 1.234-.704 1.704l-1.568 1.568a1.183 1.183 0 0 0-.289.878c.045.324-.06.653-.29.883l-1.568 1.568a2.41 2.41 0 0 1-1.704.704c-.628 0-1.234-.234-1.704-.704l-1.568-1.568a1.183 1.183 0 0 0-.878-.289c-.324.045-.653-.06-.883-.29l-1.568-1.568a2.41 2.41 0 0 1-.704-1.704c0-.628.234-1.234.704-1.704l1.568-1.568a1.183 1.183 0 0 0 .289-.878c-.045-.324.06-.653.29-.883l1.568-1.568a2.41 2.41 0 0 1 1.704-.704c.628 0 1.234.234 1.704.704l1.568 1.568c.23.23.335.559.29.883z"></path>
        </svg>
      </view>
      <text class="tab-label-text">死活</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </view>
      <text class="tab-label-text">商城</text>
    </view>

    <view class="tab-btn" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="tab-icon-wrapper">
        <svg class="tab-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <polyline points="16 11 18 13 22 9"></polyline>
        </svg>
      </view>
      <text class="tab-label-text">我的</text>
    </view>
  </view>
</view>

