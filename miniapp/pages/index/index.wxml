<view class="page-wrap">
  <!-- Top Navigation Header (1:1 with Web Navbar) -->
  <view class="top-nav-bar">
    <view class="nav-brand-left">
      <view class="nav-logo-box">
        <text class="nav-logo-emoji">🐼</text>
      </view>
      <view class="nav-brand-text">
        <view class="nav-brand-title-row">
          <text class="nav-brand-title">一诺弈学</text>
          <text class="nav-brand-badge">YiNuo Go</text>
        </view>
        <text class="nav-brand-slogan">少儿互动启蒙 · 快乐学棋</text>
      </view>
    </view>

    <view class="nav-right-actions">
      <view class="nav-profile-pill">
        <text class="nav-user-avatar">🐼</text>
        <text class="nav-user-name">{{nickname}}</text>
        <text class="nav-user-caret">▼</text>
      </view>
      
      <view class="nav-icon-btn" bindtap="toggleSound">
        <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
      </view>
      
      <view class="nav-icon-btn" bindtap="openHelp">
        <svg class="nav-svg-icon text-amber" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </view>
    </view>
  </view>

  <!-- Hero Welcome Banner (Exact 1:1 Match) -->
  <view class="hero-banner">
    <view class="hero-sparkle-tag">
      <svg class="tag-sparkle-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
      </svg>
      <text>少儿围棋启蒙世界 · 开启聪明大脑</text>
    </view>
    
    <view class="hero-title">欢迎来到 一诺弈学！</view>
    <view class="hero-sub">你好，{{nickname}}！黑白子就像神奇的黑白精灵，在小小的棋盘上筑造属于你的智慧城堡吧！</view>

    <!-- 3 Action Buttons (Exact 1:1 Match) -->
    <view class="hero-actions-row">
      <view class="hero-btn-primary" bindtap="navTo" data-url="/pages/learn/learn">
        <text>开启闯关大冒险</text>
        <text class="hero-arrow">→</text>
      </view>
      
      <view class="hero-btn-glass" bindtap="navTo" data-url="/pages/arcade/arcade">
        <svg class="hero-zap-icon" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
        <text>极速反应乐园</text>
      </view>
      
      <view class="hero-btn-gold" bindtap="openQuestModal">
        <text>📅 每日打卡任务</text>
      </view>
    </view>
  </view>

  <!-- Section Heading (Exact 1:1 Match) -->
  <view class="section-heading">
    <text class="section-rocket">🚀</text>
    <text class="section-title">全能学棋乐园</text>
  </view>

  <!-- 2-Column Grid of 6 Feature Cards (Exact 1:1 Match with SVG Icons) -->
  <view class="cards-grid-2col">
    <!-- Card 1: 趣味闯关 -->
    <view class="feature-card" bindtap="navTo" data-url="/pages/learn/learn">
      <view class="card-top-row">
        <view class="card-icon-box grad-emerald">
          <svg class="card-svg-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="6" y1="12" x2="10" y2="12"></line>
            <line x1="8" y1="10" x2="8" y2="14"></line>
            <line x1="15" y1="13" x2="15.01" y2="13"></line>
            <line x1="18" y1="11" x2="18.01" y2="11"></line>
            <rect width="20" height="12" x="2" y="6" rx="6"></rect>
          </svg>
        </view>
        <view class="card-badge bg-emerald">推荐 · 循序渐进</view>
      </view>
      <view class="card-title-group">
        <text class="card-title">趣味闯关</text>
        <text class="card-title-en">Adventure Quest</text>
      </view>
      <text class="card-desc">从数气到手筋，6大篇章24个闯关小故事，带你一步步成为围棋小高手！</text>
      <view class="card-bottom-row">
        <text class="card-stats">已收集 {{stars}} 颗星星</text>
        <text class="card-enter-link">进入 →</text>
      </view>
    </view>

    <!-- Card 2: 反应乐园 -->
    <view class="feature-card" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="card-top-row">
        <view class="card-icon-box grad-orange">
          <svg class="card-svg-icon" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="1">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </view>
        <view class="card-badge bg-rose">🔥 热门刺激</view>
      </view>
      <view class="card-title-group">
        <text class="card-title">反应乐园</text>
        <text class="card-title-en">Speed Arcade 60s</text>
      </view>
      <text class="card-desc">60秒闪电提子、数气大作战、连断速判！在极速连击中秒变肌肉记忆！</text>
      <view class="card-bottom-row">
        <text class="card-stats">最高得分 125 分</text>
        <text class="card-enter-link">进入 →</text>
      </view>
    </view>

    <!-- Card 3: 吃子对弈场 -->
    <view class="feature-card" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="card-top-row">
        <view class="card-icon-box grad-amber">
          <svg class="card-svg-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline>
            <line x1="13" y1="19" x2="19" y2="13"></line>
            <line x1="16" y1="16" x2="20" y2="20"></line>
            <line x1="19" y1="21" x2="21" y2="19"></line>
            <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline>
            <line x1="5" y1="14" x2="9" y2="18"></line>
            <line x1="7" y1="17" x2="4" y2="20"></line>
            <line x1="3" y1="19" x2="5" y2="21"></line>
          </svg>
        </view>
        <view class="card-badge bg-orange">⚡ 极速对局</view>
      </view>
      <view class="card-title-group">
        <text class="card-title">吃子对弈场</text>
        <text class="card-title-en">First to Capture Go</text>
      </view>
      <text class="card-desc">先吃1子或3子获胜！极简规则、极速开局，零基础孩子最爱的对战模式！</text>
      <view class="card-bottom-row">
        <text class="card-stats">已获胜 4 场</text>
        <text class="card-enter-link">进入 →</text>
      </view>
    </view>

    <!-- Card 4: 每日死活题 -->
    <view class="feature-card" bindtap="navTo" data-url="/pages/tsumego/tsumego">
      <view class="card-top-row">
        <view class="card-icon-box grad-rose">
          <svg class="card-svg-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.704 1.076.704 1.704s-.234 1.234-.704 1.704l-1.568 1.568a1.183 1.183 0 0 0-.289.878c.045.324-.06.653-.29.883l-1.568 1.568a2.41 2.41 0 0 1-1.704.704c-.628 0-1.234-.234-1.704-.704l-1.568-1.568a1.183 1.183 0 0 0-.878-.289c-.324.045-.653-.06-.883-.29l-1.568-1.568a2.41 2.41 0 0 1-.704-1.704c0-.628.234-1.234.704-1.704l1.568-1.568a1.183 1.183 0 0 0 .289-.878c-.045-.324.06-.653.29-.883l1.568-1.568a2.41 2.41 0 0 1 1.704-.704c.628 0 1.234.234 1.704.704l1.568 1.568c.23.23.559.335.883.29l1.568-1.568a2.41 2.41 0 0 1 1.704-.704c.628 0 1.234.234 1.704.704l1.568 1.568c.23.23.335.559.29.883z"></path>
          </svg>
        </view>
        <view class="card-badge bg-darkrose">46道必修死活</view>
      </view>
      <view class="card-title-group">
        <text class="card-title">每日死活题</text>
        <text class="card-title-en">Daily Tsumego</text>
      </view>
      <text class="card-desc">精选吃子、做眼、杀棋、对杀、劫争46道经典实战题，AI智能分步拆解！</text>
      <view class="card-bottom-row">
        <text class="card-stats">已攻克 {{solvedCount}} / 46 题</text>
        <text class="card-enter-link">进入 →</text>
      </view>
    </view>

    <!-- Card 5: 错题弱点突破 -->
    <view class="feature-card" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="card-top-row">
        <view class="card-icon-box grad-purple">
          <svg class="card-svg-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <polyline points="10 2 10 10 13 7 16 10 16 2"></polyline>
          </svg>
        </view>
        <view class="card-badge bg-indigo">双倍金币</view>
      </view>
      <view class="card-title-group">
        <text class="card-title">错题弱点突破</text>
        <text class="card-title-en">Mistake Notebook</text>
      </view>
      <text class="card-desc">自动收录做错的死活与手筋，针对性专项复习，重新解对可领双倍金币！</text>
      <view class="card-bottom-row">
        <text class="card-stats">已消灭 0 处弱点</text>
        <text class="card-enter-link">进入 →</text>
      </view>
    </view>

    <!-- Card 6: 装扮商城 -->
    <view class="feature-card" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="card-top-row">
        <view class="card-icon-box grad-pink">
          <svg class="card-svg-icon" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </view>
        <view class="card-badge bg-pink">主题工坊</view>
      </view>
      <view class="card-title-group">
        <text class="card-title">装扮商城</text>
        <text class="card-title-en">Go Shop & Themes</text>
      </view>
      <text class="card-desc">用做题赢取的金币兑换原木、糖果、星空、翡翠等专属棋盘与可爱头像！</text>
      <view class="card-bottom-row">
        <text class="card-stats">金币余额: {{coins}}</text>
        <text class="card-enter-link">进入 →</text>
      </view>
    </view>
  </view>

  <!-- 7-Tab Bottom Floating Navigation Bar (Exact 1:1 Match with Web) -->
  <view class="custom-bottom-tabbar">
    <!-- Tab 1: 首页 (Active) -->
    <view class="tab-item active" bindtap="navTo" data-url="/pages/index/index">
      <view class="tab-indicator"></view>
      <view class="tab-icon-box active">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </view>
      <text class="tab-label active">首页</text>
    </view>

    <!-- Tab 2: 闯关 -->
    <view class="tab-item" bindtap="navTo" data-url="/pages/learn/learn">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="12" x2="10" y2="12"></line>
          <line x1="8" y1="10" x2="8" y2="14"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <line x1="18" y1="11" x2="18.01" y2="11"></line>
          <rect width="20" height="12" x="2" y="6" rx="6"></rect>
        </svg>
      </view>
      <text class="tab-label">闯关</text>
    </view>

    <!-- Tab 3: 乐园 -->
    <view class="tab-item" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </view>
      <text class="tab-label">乐园</text>
    </view>

    <!-- Tab 4: 吃子 -->
    <view class="tab-item" bindtap="navTo" data-url="/pages/arcade/arcade">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline>
          <line x1="13" y1="19" x2="19" y2="13"></line>
          <line x1="16" y1="16" x2="20" y2="20"></line>
          <line x1="19" y1="21" x2="21" y2="19"></line>
          <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline>
          <line x1="5" y1="14" x2="9" y2="18"></line>
          <line x1="7" y1="17" x2="4" y2="20"></line>
          <line x1="3" y1="19" x2="5" y2="21"></line>
        </svg>
      </view>
      <text class="tab-label">吃子</text>
    </view>

    <!-- Tab 5: 死活 -->
    <view class="tab-item" bindtap="navTo" data-url="/pages/tsumego/tsumego">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.704 1.076.704 1.704s-.234 1.234-.704 1.704l-1.568 1.568a1.183 1.183 0 0 0-.289.878c.045.324-.06.653-.29.883l-1.568 1.568a2.41 2.41 0 0 1-1.704.704c-.628 0-1.234-.234-1.704-.704l-1.568-1.568a1.183 1.183 0 0 0-.878-.289c-.324.045-.653-.06-.883-.29l-1.568-1.568a2.41 2.41 0 0 1-.704-1.704c0-.628.234-1.234.704-1.704l1.568-1.568a1.183 1.183 0 0 0 .289-.878c-.045-.324.06-.653.29-.883l1.568-1.568a2.41 2.41 0 0 1 1.704-.704c.628 0 1.234.234 1.704.704l1.568 1.568c.23.23.559.335.883.29l1.568-1.568a2.41 2.41 0 0 1 1.704-.704c.628 0 1.234.234 1.704.704l1.568 1.568c.23.23.335.559.29.883z"></path>
        </svg>
      </view>
      <text class="tab-label">死活</text>
    </view>

    <!-- Tab 6: 商城 -->
    <view class="tab-item" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </view>
      <text class="tab-label">商城</text>
    </view>

    <!-- Tab 7: 我的 -->
    <view class="tab-item" bindtap="navTo" data-url="/pages/profile/profile">
      <view class="tab-icon-box">
        <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <polyline points="16 11 18 13 22 9"></polyline>
        </svg>
      </view>
      <text class="tab-label">我的</text>
    </view>
  </view>

  <!-- Daily Quest Modal Popup -->
  <view wx:if="{{showQuestModal}}" class="modal-mask" bindtap="closeQuestModal">
    <view class="modal-content" catchtap="stopBubble">
      <view class="quest-modal-header">
        <text class="quest-modal-title">🎯 每日打卡任务</text>
        <button class="btn-close-modal" bindtap="closeQuestModal">✕</button>
      </view>
      <view class="quest-list">
        <view class="quest-item">
          <view class="quest-left">
            <text class="quest-icon">📖</text>
            <view>
              <text class="quest-name">完成 1 节启蒙闯关</text>
              <text class="quest-reward">奖励: 🪙 +20 / ⭐ +1</text>
            </view>
          </view>
          <text class="quest-badge">进行中</text>
        </view>
        <view class="quest-item">
          <view class="quest-left">
            <text class="quest-icon">🧩</text>
            <view>
              <text class="quest-name">解答 2 道死活题</text>
              <text class="quest-reward">奖励: 🪙 +30 / ⚡ +40XP</text>
            </view>
          </view>
          <text class="quest-badge">进行中</text>
        </view>
        <view class="quest-item">
          <view class="quest-left">
            <text class="quest-icon">🤖</text>
            <view>
              <text class="quest-name">进行 1 场萌宠对弈</text>
              <text class="quest-reward">奖励: 🪙 +50 / ⚡ +80XP</text>
            </view>
          </view>
          <text class="quest-badge">进行中</text>
        </view>
      </view>
      <button class="btn-confirm-quest" bindtap="closeQuestModal">知道了，去完成！</button>
    </view>
  </view>
</view>

